generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum MaterialType {
  FILM
  LIQUID_ADHESIVE
  CORE
}

enum MaterialTransactionType {
  RECEIPT
  PRODUCTION_ISSUE
  DAMAGE
  CORRECTION
}

enum MaterialUnit {
  KG
  PCS
}

enum BatchStatus {
  COMPLETED
  CANCELLED
}

enum FinishedGoodsTransactionType {
  PRODUCTION_RECEIPT
  ORDER_DISPATCH
  CORRECTION
}

enum OrderUnit {
  ROLLS
  METRES
  NET_KG
}

enum OrderStatus {
  CONFIRMED
  PARTIALLY_DISPATCHED
  FULFILLED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
}

enum CorrectionTarget {
  MATERIAL_LEDGER
  FINISHED_GOODS_LEDGER
  PRODUCTION_BATCH
  SALES_ORDER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdSpecifications TapeSpecification[]
  materialLedgers       MaterialLedger[]
  productionBatches     ProductionBatch[]
  finishedGoodsLedgers  FinishedGoodsLedger[]
  salesOrders           SalesOrder[]
  dispatches            Dispatch[]
  cancellations         Cancellation[]
  corrections           CorrectionRecord[]

  @@map("users")
}

model TapeSpecification {
  id                    String   @id @default(cuid())
  code                  String   @unique
  version               Int      @default(1)
  widthMm               Decimal  @db.Decimal(10, 2)
  filmGsm               Decimal  @db.Decimal(10, 2)
  dryCoatingGsm         Decimal  @db.Decimal(10, 2)
  adhesiveSolidsPercent Decimal  @db.Decimal(5, 2)
  rollLengthM           Decimal  @db.Decimal(10, 2)
  isUsedForProduction   Boolean  @default(false)
  createdById           String
  createdBy             User     @relation(fields: [createdById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  productionBatches    ProductionBatch[]
  finishedGoodsLedgers FinishedGoodsLedger[]
  salesOrders          SalesOrder[]
  orderReservations    OrderReservation[]

  @@map("tape_specifications")
}

model MaterialLedger {
  id              String                  @id @default(cuid())
  materialType    MaterialType
  transactionType MaterialTransactionType
  quantity        Decimal                 @db.Decimal(12, 4) // Positive for additions, negative for deductions
  unit            MaterialUnit
  referenceType   String?                 // "BATCH", "RECEIPT", "DAMAGE", "CORRECTION"
  referenceId     String?
  notes           String?
  userId          String
  user            User                    @relation(fields: [userId], references: [id])
  createdAt       DateTime                @default(now())

  @@index([materialType, createdAt])
  @@map("material_ledger")
}

model ProductionBatch {
  id                     String            @id @default(cuid())
  batchNumber            String            @unique
  specificationId        String
  specification          TapeSpecification @relation(fields: [specificationId], references: [id])
  rollCount              Int
  filmIssuedKg           Decimal           @db.Decimal(12, 4)
  liquidAdhesiveIssuedKg Decimal           @db.Decimal(12, 4)
  dryWastageKg           Decimal           @db.Decimal(12, 4)
  coresIssued            Int
  expectedFilmKg         Decimal           @db.Decimal(12, 4)
  expectedDryAdhesiveKg  Decimal           @db.Decimal(12, 4)
  expectedLiquidAdhesiveKg Decimal         @db.Decimal(12, 4)
  actualDryAdhesiveKg    Decimal           @db.Decimal(12, 4)
  productionInputKg      Decimal           @db.Decimal(12, 4)
  netTapeProducedKg      Decimal           @db.Decimal(12, 4)
  productionOutputKg     Decimal           @db.Decimal(12, 4)
  productionDifferenceKg Decimal           @db.Decimal(12, 4)
  status                 BatchStatus       @default(COMPLETED)
  createdById            String
  createdBy              User              @relation(fields: [createdById], references: [id])
  createdAt              DateTime          @default(now())

  @@map("production_batches")
}

model FinishedGoodsLedger {
  id              String                       @id @default(cuid())
  specificationId String
  specification   TapeSpecification            @relation(fields: [specificationId], references: [id])
  transactionType FinishedGoodsTransactionType
  rollCount       Int                          // Positive for receipt, negative for dispatch/adjustment
  netTapeKg       Decimal                      @db.Decimal(12, 4)
  metres          Decimal                      @db.Decimal(12, 4)
  referenceType   String?                      // "PRODUCTION_BATCH", "ORDER_DISPATCH", "CORRECTION"
  referenceId     String?
  notes           String?
  userId          String
  user            User                         @relation(fields: [userId], references: [id])
  createdAt       DateTime                     @default(now())

  @@index([specificationId, createdAt])
  @@map("finished_goods_ledger")
}

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime     @default(now())

  salesOrders   SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  customerId            String
  customer              Customer          @relation(fields: [customerId], references: [id])
  specificationId       String
  specification         TapeSpecification @relation(fields: [specificationId], references: [id])
  orderedUnit           OrderUnit
  originalInputQuantity Decimal           @db.Decimal(12, 4)
  orderedRolls          Int
  reservedRolls         Int               @default(0)
  dispatchedRolls       Int               @default(0)
  cancelledRolls        Int               @default(0)
  status                OrderStatus       @default(CONFIRMED)
  notes                 String?
  createdById           String
  createdBy             User              @relation(fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  reservations          OrderReservation[]
  dispatches            Dispatch[]
  cancellations         Cancellation[]

  @@map("sales_orders")
}

model OrderReservation {
  id              String            @id @default(cuid())
  orderId         String
  order           SalesOrder        @relation(fields: [orderId], references: [id])
  specificationId String
  specification   TapeSpecification @relation(fields: [specificationId], references: [id])
  reservedRolls   Int
  releasedRolls   Int               @default(0)
  dispatchedRolls Int               @default(0)
  status          ReservationStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orderId])
  @@index([specificationId])
  @@map("order_reservations")
}

model Dispatch {
  id             String     @id @default(cuid())
  dispatchNumber String     @unique
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id])
  rollCount      Int
  notes          String?
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())

  @@index([orderId])
  @@map("dispatches")
}

model Cancellation {
  id            String     @id @default(cuid())
  orderId       String
  order         SalesOrder @relation(fields: [orderId], references: [id])
  releasedRolls Int
  reason        String
  createdById   String
  createdBy     User       @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  @@index([orderId])
  @@map("cancellations")
}

model CorrectionRecord {
  id                 String           @id @default(cuid())
  targetType         CorrectionTarget
  targetId           String
  reason             String           @db.Text
  priorDataJson      String           @db.Text
  correctionDataJson String           @db.Text
  adminId            String
  admin              User             @relation(fields: [adminId], references: [id])
  createdAt          DateTime         @default(now())

  @@index([targetType, targetId])
  @@map("correction_records")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  detailsJson String?  @db.Text
  userId      String
  userRole    String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String   @unique
  route          String
  requestHash    String
  responseStatus Int
  responseBody   String   @db.Text
  userId         String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([key])
  @@map("idempotency_keys")
}
