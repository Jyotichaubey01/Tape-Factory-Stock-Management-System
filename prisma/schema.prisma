generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String                @db.VarChar(100)
  email                String                @unique
  passwordHash         String                @db.VarChar(255)
  role                 Role
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  audit_logs           AuditLog[]
  cancellations        Cancellation[]
  correction_records   CorrectionRecord[]
  customers            Customer[]
  dispatches           Dispatch[]
  finishedGoodsLedgers FinishedGoodsLedger[]
  materialLedgers      MaterialLedger[]
  material_receipts    material_receipts[]
  order_reservations   OrderReservation[]
  production_batches   ProductionBatch[]
  sales_orders         SalesOrder[]
  sessions             sessions[]

  @@index([role])
  @@map("users")
}

model TapeSpecification {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique @db.VarChar(32)
  widthMm              Decimal               @db.Decimal(12, 4)
  filmGsm              Decimal               @db.Decimal(12, 4)
  dryAdhesiveGsm       Decimal               @db.Decimal(12, 4)
  solidsPercent        Decimal               @db.Decimal(8, 4)
  rollLengthM          Decimal               @db.Decimal(14, 4)
  createdAt            DateTime              @default(now())
  finishedGoodsLedgers FinishedGoodsLedger[]
  productionBatches    ProductionBatch[]
  salesOrders          SalesOrder[]

  @@index([createdAt])
  @@map("tape_specifications")
}

model MaterialLedger {
  id                                                                      Int                      @id @default(autoincrement())
  material                                                                material_ledger_material
  type                                                                    material_ledger_type
  quantity                                                                Decimal                  @db.Decimal(18, 6)
  reference                                                               String                   @db.VarChar(100)
  reason                                                                  String?                  @db.VarChar(300)
  userId                                                                  Int
  batchId                                                                 Int?
  createdAt                                                               DateTime                 @default(now())
  correction_records_correction_records_materialLedgerIdTomaterial_ledger CorrectionRecord?        @relation("correction_records_materialLedgerIdTomaterial_ledger")
  correction_records_correction_records_originalLedgerIdTomaterial_ledger CorrectionRecord[]       @relation("correction_records_originalLedgerIdTomaterial_ledger")
  production_batches                                                      ProductionBatch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  user                                                                    User                     @relation(fields: [userId], references: [id])
  material_receipts                                                       material_receipts?

  @@index([batchId], map: "material_ledger_batchId_fkey")
  @@index([material, createdAt])
  @@index([reference])
  @@index([type, createdAt])
  @@index([userId], map: "material_ledger_userId_fkey")
  @@map("material_ledger")
}

model ProductionBatch {
  id                     Int                  @id @default(autoincrement())
  batchNumber            String               @unique @db.VarChar(64)
  specificationId        Int
  rolls                  Int
  filmIssuedKg           Decimal              @db.Decimal(18, 6)
  adhesiveIssuedKg       Decimal              @db.Decimal(18, 6)
  dryWastageKg           Decimal              @db.Decimal(18, 6)
  expectedFilmKg         Decimal              @db.Decimal(18, 6)
  expectedAdhesiveKg     Decimal              @db.Decimal(18, 6)
  actualDryAdhesiveKg    Decimal              @db.Decimal(18, 6)
  productionDifferenceKg Decimal              @db.Decimal(18, 6)
  userId                 Int
  createdAt              DateTime             @default(now())
  finished_goods_ledger  FinishedGoodsLedger?
  material_ledger        MaterialLedger[]
  specification          TapeSpecification    @relation(fields: [specificationId], references: [id])
  users                  User                 @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([specificationId, createdAt])
  @@index([userId], map: "production_batches_userId_fkey")
  @@map("production_batches")
}

model FinishedGoodsLedger {
  id                 Int                        @id @default(autoincrement())
  specificationId    Int
  deltaRolls         Int
  type               finished_goods_ledger_type
  reference          String                     @db.VarChar(100)
  reason             String?                    @db.VarChar(300)
  userId             Int
  batchId            Int?                       @unique
  orderId            Int?
  createdAt          DateTime                   @default(now())
  production_batches ProductionBatch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sales_orders       SalesOrder?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  specification      TapeSpecification          @relation(fields: [specificationId], references: [id])
  user               User                       @relation(fields: [userId], references: [id])

  @@index([specificationId, createdAt])
  @@index([orderId], map: "finished_goods_ledger_orderId_fkey")
  @@index([type, createdAt])
  @@index([userId], map: "finished_goods_ledger_userId_fkey")
  @@map("finished_goods_ledger")
}

model Customer {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  email       String?
  userId      Int
  createdAt   DateTime     @default(now())
  users       User         @relation(fields: [userId], references: [id])
  salesOrders SalesOrder[]

  @@index([name])
  @@index([userId], map: "customers_userId_fkey")
  @@map("customers")
}

model SalesOrder {
  id                    Int                   @id @default(autoincrement())
  orderNumber           String                @unique @db.VarChar(64)
  customerId            Int
  specificationId       Int
  orderedRolls          Int
  dispatchedRolls       Int                   @default(0)
  cancelledRolls        Int                   @default(0)
  userId                Int
  createdAt             DateTime              @default(now())
  cancellations         Cancellation[]
  dispatches            Dispatch[]
  finished_goods_ledger FinishedGoodsLedger[]
  reservations          OrderReservation[]
  customer              Customer              @relation(fields: [customerId], references: [id])
  specification         TapeSpecification     @relation(fields: [specificationId], references: [id])
  users                 User                  @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([specificationId, createdAt])
  @@index([userId], map: "sales_orders_userId_fkey")
  @@map("sales_orders")
}

model OrderReservation {
  id        Int                      @id @default(autoincrement())
  orderId   Int
  event     order_reservations_event
  rolls     Int
  userId    Int
  createdAt DateTime                 @default(now())
  order     SalesOrder               @relation(fields: [orderId], references: [id])
  users     User                     @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@index([userId], map: "order_reservations_userId_fkey")
  @@map("order_reservations")
}

model Dispatch {
  id        Int        @id @default(autoincrement())
  orderId   Int
  rolls     Int
  reference String     @db.VarChar(80)
  userId    Int
  createdAt DateTime   @default(now())
  order     SalesOrder @relation(fields: [orderId], references: [id])
  users     User       @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@index([userId], map: "dispatches_userId_fkey")
  @@map("dispatches")
}

model Cancellation {
  id        Int        @id @default(autoincrement())
  orderId   Int
  rolls     Int
  reason    String     @db.VarChar(300)
  userId    Int
  createdAt DateTime   @default(now())
  order     SalesOrder @relation(fields: [orderId], references: [id])
  users     User       @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@index([userId], map: "cancellations_userId_fkey")
  @@map("cancellations")
}

model CorrectionRecord {
  id                                                                   Int                         @id @default(autoincrement())
  material                                                             correction_records_material
  adjustment                                                           Decimal                     @db.Decimal(18, 6)
  reason                                                               String                      @db.VarChar(300)
  reference                                                            String                      @db.VarChar(80)
  originalLedgerId                                                     Int
  materialLedgerId                                                     Int                         @unique
  userId                                                               Int
  createdAt                                                            DateTime                    @default(now())
  material_ledger_correction_records_materialLedgerIdTomaterial_ledger MaterialLedger              @relation("correction_records_materialLedgerIdTomaterial_ledger", fields: [materialLedgerId], references: [id])
  material_ledger_correction_records_originalLedgerIdTomaterial_ledger MaterialLedger              @relation("correction_records_originalLedgerIdTomaterial_ledger", fields: [originalLedgerId], references: [id])
  users                                                                User                        @relation(fields: [userId], references: [id])

  @@index([material, createdAt])
  @@index([originalLedgerId], map: "correction_records_originalLedgerId_fkey")
  @@index([userId], map: "correction_records_userId_fkey")
  @@map("correction_records")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(100)
  reference  String   @db.VarChar(100)
  reason     String?  @db.VarChar(300)
  details    Json?
  userId     Int
  createdAt  DateTime @default(now())
  users      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, createdAt])
  @@index([reference])
  @@map("audit_logs")
}

model IdempotencyKey {
  key       String   @id @db.VarChar(100)
  operation String   @db.VarChar(80)
  result    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}

model material_balances {
  material  material_balances_material @id
  quantity  Decimal                    @default(0.000000) @db.Decimal(18, 6)
  updatedAt DateTime
}

model material_receipts {
  id              Int                        @id @default(autoincrement())
  material        material_receipts_material
  quantity        Decimal                    @db.Decimal(18, 6)
  reference       String                     @db.VarChar(80)
  ledgerId        Int                        @unique
  userId          Int
  createdAt       DateTime                   @default(now())
  material_ledger MaterialLedger             @relation(fields: [ledgerId], references: [id])
  users           User                       @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId], map: "material_receipts_userId_fkey")
}

model sessions {
  tokenHash String   @id @db.Char(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

enum Role {
  ADMIN
  STAFF
}

enum material_balances_material {
  FILM
  ADHESIVE
  CORES
}

enum correction_records_material {
  FILM
  ADHESIVE
  CORES
}

enum material_ledger_material {
  FILM
  ADHESIVE
  CORES
}

enum material_receipts_material {
  FILM
  ADHESIVE
  CORES
}

enum material_ledger_type {
  RECEIPT
  PRODUCTION_ISSUE
  DAMAGE
  CORRECTION
}

enum order_reservations_event {
  RESERVE
  RELEASE
  DISPATCH
}

enum finished_goods_ledger_type {
  PRODUCTION
  DISPATCH
  CORRECTION
}
